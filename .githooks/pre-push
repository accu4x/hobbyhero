#!/bin/sh
# Blocks a push unless the leak check passes (SPEC-repo-and-site.md §2). It fails closed, so a
# missing ../private/hobbyhero-denylist.txt blocks the push too. Install once per clone:
#
#   git config core.hooksPath .githooks
#
# `git push --no-verify` bypasses it when you need to.

cd "$(git rev-parse --show-toplevel)" || exit 1
python tests/leak_check.py || exit 1
